{
  "name": "laborstay",
  "version": "2.0.0",
  "private": true,
  "description": "LaborStay \u2014 Booking.com-style platform for labour camp accommodation, equipment rental, and services in Saudi Arabia.",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "npm --prefix backend run db:seed",
    "build": "npm --prefix frontend run build",
    "db:demo": "npm --prefix backend run db:demo",
    "db:seed:v2": "npm --prefix backend run db:seed:v2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "frontend"
  ]
}