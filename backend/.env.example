# ============ Server ============
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
APP_VERSION=2.0.0

# ============ Database ============
# DB_DRIVER = "postgres" or "sqlite"
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laborstay
DB_USER=postgres
DB_PASSWORD=postgres
SQLITE_PATH=./data/laborstay.sqlite

# ============ JWT ============
JWT_SECRET=laborstay_secret_key_change_me_in_prod
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ============ Email (Nodemailer) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@laborstay.sa

# ============ File Upload ============
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ============ Third-party (placeholders) ============
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY
TAP_SECRET_KEY=sk_test_YOUR_TAP_SECRET_KEY
TAP_PUBLIC_KEY=pk_test_YOUR_TAP_PUBLIC_KEY

# ============ Business constants ============
COMMISSION_RATE=0.10
VAT_RATE=0.15

# ============ WhatsApp & SMS (Twilio) ============
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# ============ SMS (Unifonic - Saudi Arabia) ============
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=LaborStay

# ============ SADAD Payment ============
SADAD_MERCHANT_ID=
SADAD_API_KEY=
SADAD_API_URL=https://sadad.com/api/v1

# ============ ERP Integration ============
# ERP_TYPE = none | sap | odoo | zoho
ERP_TYPE=none
ERP_API_URL=
ERP_API_KEY=
ERP_COMPANY_ID=
ERP_SYNC_INTERVAL=60

# ============ Biometric System ============
BIOMETRIC_API_URL=
BIOMETRIC_API_KEY=
BIOMETRIC_SYSTEM_TYPE=generic

# ============ CCTV System ============
CCTV_SYSTEM_TYPE=generic
CCTV_API_URL=
CCTV_API_KEY=

# ============ Access Control ============
ACCESS_SYSTEM_TYPE=generic
ACCESS_API_URL=
ACCESS_API_KEY=

# ============ GPS Tracking ============
GPS_PROVIDER_API_KEY=
GPS_PROVIDER_URL=

# ============ Currency Exchange ============
EXCHANGE_RATE_API_KEY=

# ============ Redis (optional - falls back to memory cache) ============
REDIS_URL=

# ============ 2FA ============
TWO_FA_APP_NAME=LaborStay
TWO_FA_ISSUER=LaborStay.SA

# ============ OpenAI Chatbot (optional) ============
OPENAI_API_KEY=
